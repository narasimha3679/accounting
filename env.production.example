# Production Environment Variables
# Copy to frontend/.env (or .env.production) and fill in values

# Supabase project URL (https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public API key (never use service_role in the browser)
VITE_SUPABASE_ANON_KEY=

# Storage bucket for expense receipts (must already exist)
VITE_SUPABASE_STORAGE_BUCKET=expense-files

# Umami Analytics (self-hosted)
# Set these in Coolify for production deployment
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=