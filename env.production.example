# Production Environment Variables
# Copy to frontend/.env (or .env.production) and fill in values

# Go API public URL
VITE_API_URL=https://api.cashual.org

# Backward-compatible alias (optional)
VITE_BACKEND_URL=https://api.cashual.org

# Storage bucket label used by frontend upload helpers
VITE_SUPABASE_STORAGE_BUCKET=expense-files

# Umami Analytics (self-hosted)
# Set these in Coolify for production deployment
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=

# VAPID Public Key for Web Push Notifications
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Store private key on backend as VAPID_PRIVATE_KEY
# Store the public key here
VITE_VAPID_PUBLIC_KEY=