# Production Environment Variables
# Copy to frontend/.env (or .env.production) and fill in values

# Supabase project URL (https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public API key (never use service_role in the browser)
VITE_SUPABASE_ANON_KEY=

# Storage bucket for expense receipts (must already exist)
VITE_SUPABASE_STORAGE_BUCKET=expense-files

# Umami Analytics (self-hosted)
# Set these in Coolify for production deployment
VITE_UMAMI_URL=https://umami.suparesume.online
VITE_UMAMI_WEBSITE_ID=f869e2d8-d772-40ad-93fc-34e441ffdb1d

# VAPID Public Key for Web Push Notifications
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Store the private key as a Supabase secret: VAPID_PRIVATE_KEY
# Store the public key here: VITE_VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=