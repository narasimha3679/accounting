DATABASE_URL=postgres://user:pass@localhost:5432/accounting?sslmode=disable
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_ISSUER=cashual-api
JWT_AUDIENCE=cashual-web
HTTP_ADDR=:8080
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
RUN_MIGRATIONS=true
MIGRATIONS_PATH=file://migrations

# Optional: Backblaze B2 (S3-compatible)
# B2_S3_ENDPOINT=https://s3.us-west-000.backblazeb2.com
# B2_REGION=us-west-000
# B2_BUCKET=your-bucket
# B2_KEY_ID=
# B2_APPLICATION_KEY=

# Email (invoice + password reset)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Pay-myself optimizer (optional Node script)
# OPTIMIZER_SCRIPT=legacy/payMyselfOptimizer.js
# TAX_DATA_PATH=

# OCR / push (when enabled)
# GEMINI_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com
